<Window x:Class="WpfCommonCode.Imaging.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vsui="clr-namespace:Vintasoft.Imaging.Wpf.UI;assembly=Vintasoft.Imaging.Wpf.UI"
        xmlns:local="clr-namespace:WpfCommonCode.Imaging"
        mc:Ignorable="d"
        MinWidth="300" MinHeight="200"
        Title="Image Preview" Height="500" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="0" Grid.Column="0" Padding="3" Margin="3">
            <TextBlock x:Name="folderPathTextBox"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="0" Grid.Column="1" Padding="3" Margin="3">
            <TextBlock x:Name="fileNameTextBox" TextAlignment="Center"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="1" Grid.Column="0" Padding="3" Margin="3">
        <vsui:WpfFolderThumbnailViewer FocusedIndexChanged="folderThumbnailViewer_FocusedIndexChanged" x:Name="folderThumbnailViewer" MouseDoubleClick="folderThumbnailViewer_MouseDoubleClick"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="1" Padding="3" Margin="3">
        <vsui:WpfThumbnailViewer ThumbnailSize="150,200" ThumbnailFlowStyle="WrappedRows" x:Name="thumbnailViewer"/>
        </Border>
        <Button Grid.Row="2" Grid.Column="0" Margin="4" Click="changeFolderButton_Click">Change Directory...</Button>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Margin="4" Grid.Column="0" x:Name="addAllButton" Click="addAllButton_Click">Add All Pages</Button>
            <Button Margin="4" Grid.Column="1" x:Name="addSelectedButton" Click="addSelectedButton_Click">Add Selected Pages</Button>
            <Button Margin="4" Grid.Column="2" x:Name="closeButton" Click="closeButton_Click">Close</Button>
        </Grid>
    </Grid>
</Window>
