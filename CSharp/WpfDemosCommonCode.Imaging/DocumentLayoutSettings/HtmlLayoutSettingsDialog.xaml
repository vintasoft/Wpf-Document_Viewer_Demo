<Imaging:DocumentLayoutSettingsDialog 
        x:Class="WpfCommonCode.Imaging.HtmlLayoutSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:Imaging="clr-namespace:WpfCommonCode.Imaging" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:CustomControls="clr-namespace:WpfCommonCode.CustomControls"
        mc:Ignorable="d"
        Title="HTML Layout Settings" Height="180" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <GroupBox x:Name="settingsGroupBox" Grid.ColumnSpan="2" Margin="3" Header="                                      ">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="47"/>
                    <ColumnDefinition Width="81*"/>
                    <ColumnDefinition Width="36*"/>
                    <ColumnDefinition Width="65*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="31*"/>
                    <RowDefinition Height="33"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Content="Page Size" Padding="0" VerticalContentAlignment="Center" Height="25" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                <ComboBox x:Name="pageSizeComboBox" Grid.Column="2" Margin="1,0,6,0" VerticalAlignment="Center" Height="22" Grid.ColumnSpan="3" SelectionChanged="pageSizeComboBox_SelectionChanged" SelectedIndex="0"/>
                <CustomControls:NumericUpDown x:Name="pageWidthNumericUpDown" Grid.Column="2" Height="26" Margin="0,6,25,0" Grid.Row="1" VerticalAlignment="Top" ValueChanged="pageSizeNumericUpDown_ValueChanged"/>
                <CustomControls:NumericUpDown x:Name="pageHeightNumericUpDown" Grid.Column="3" Height="26" Margin="0,6,45,0" Grid.Row="1" VerticalAlignment="Top" ValueChanged="pageSizeNumericUpDown_ValueChanged" Grid.ColumnSpan="2"/>
                <Label Grid.Column="4" Grid.Row="1" Content="(mm)" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,11,6,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Width="28"/>
                <Label Grid.Column="1" Content="0-Auto" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Width="47" Height="23"/>
            </Grid>
        </GroupBox>
        <CheckBox x:Name="defaultSettingsCheckBox" Content="Use default layout settings" IsChecked="True" Margin="6,2,0,0" Height="17" VerticalAlignment="Top" Checked="defaultSettingsCheckBox_CheckedChanged" Unchecked="defaultSettingsCheckBox_CheckedChanged"/>
        <Button Content="OK" x:Name="okButton" IsDefault="True" Grid.Column="1" Margin="0,0,87,5" Grid.Row="1" Click="okButton_Click" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75"/>
        <Button Content="Cancel" x:Name="cancelButton" IsCancel="True" Grid.Column="1" Margin="0,0,7,5" Grid.Row="1" Click="cancelButton_Click" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75"/>
    </Grid>
</Imaging:DocumentLayoutSettingsDialog>
